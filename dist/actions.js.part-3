          handle = candidate;
          break;
        }
      }
      let createdGoogle;
      try {
        [createdGoogle] = await db.insert(profiles).values({ email: googleLinkEmail, displayName: googleName.slice(0, 40), handle, googleSub: sub, approvalStatus: "approved", continent: "AS" }).returning();
      } catch (error) {
