        const candidate = attempt === 0 ? base : `${base}${Math.floor(100 + Math.random() * 900)}`.slice(0, 24);
        const [taken] = await db.select({ id: profiles.id }).from(profiles).where(eq(profiles.handle, candidate)).limit(1);
