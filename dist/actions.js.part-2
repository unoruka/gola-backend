  createdAt: integer2("created_at", { mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date)
}, (table) => [primaryKey({ columns: [table.storyId, table.reactorId] })]);
var bookmarks = sqliteTable("bookmarks", {
